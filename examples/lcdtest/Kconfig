# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_LCDTEST
	bool "LCD color bar test"
	default n
	depends on LCD_DEV
	---help---
		Draw colour bars and orientation markers on /dev/lcd0.

if EXAMPLES_LCDTEST

config EXAMPLES_LCDTEST_PROGNAME
	string "Program name"
	default "lcdtest"

config EXAMPLES_LCDTEST_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_LCDTEST_STACKSIZE
	int "Task stack size"
	default 4096

endif
