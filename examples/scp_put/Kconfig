config EXAMPLES_SCP_PUT
	bool "SCP upload example"
	default n
	depends on NETUTILS_LIBSSH2
	---help---
		Upload a local file to an SSH server using libssh2 SCP.

if EXAMPLES_SCP_PUT

config EXAMPLES_SCP_PUT_PROGNAME
	string "Program name"
	default "scp_put"

config EXAMPLES_SCP_PUT_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_SCP_PUT_STACKSIZE
	int "Task stack size"
	default 24576

endif
