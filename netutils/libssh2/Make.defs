ifneq ($(CONFIG_NETUTILS_LIBSSH2),)
CONFIGURED_APPS += $(APPDIR)/netutils/libssh2

# Allows `<libssh2.h>` import.

CFLAGS += -isystem $(APPDIR)/netutils/libssh2/include
endif
